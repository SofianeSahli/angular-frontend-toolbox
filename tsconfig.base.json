{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": [
      "es2020",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@shared/http-data-access": [
        "shared/http/data-access/src/index.ts"
      ],
      "@shared/stores": [
        "shared/stores/src/index.ts"
      ],
      "@shared/theme-olivier": [
        "shared/themes/olivier/src/index.ts"
      ],
      "@shared/ui-atoms": [
        "shared/ui/atoms/src/index.ts"
      ],
      "@shared/ui-molecules": [
        "shared/ui/molecules/src/index.ts"
      ],
      "@shared/ui-organisms": [
        "shared/ui/organisms/src/index.ts"
      ],
      "@shared/ui-templates": [
        "shared/ui/templates/src/index.ts"
      ],
      "@shared/ui-tokens": [
        "shared/ui/tokens/src/index.ts"
      ],
      "@shared/util-format": [
        "shared/util/format/src/index.ts"
      ]
    },
    "strict": false,
    "noUncheckedSideEffectImports": false,
    "types": [
      "*"
    ],
    "esModuleInterop": false,
    "ignoreDeprecations": "6.0"
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
