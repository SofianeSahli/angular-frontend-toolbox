{
  "name": "expenses-management",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/expenses-management/src",
  "tags": [
    "scope:expenses",
    "type:app"
  ],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath.base}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": {
          "base": "dist/apps/expenses-management"
        },
        "browser": "apps/expenses-management/src/main.ts",
        "index": "apps/expenses-management/src/index.html",
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "apps/expenses-management/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/expenses-management/public"
          }
        ],
        "styles": [
          "shared/ui/tokens/src/styles/ui.scss",
          "shared/themes/olivier/src/olivier.generated.css"
        ],
        "stylePreprocessorOptions": {
          "includePaths": [
            "shared/ui/tokens/src/styles"
          ]
        }
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/expenses-management/src/environments/environment.ts",
              "with": "apps/expenses-management/src/environments/environment.prod.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "expenses-management:build:production"
        },
        "development": {
          "buildTarget": "expenses-management:build:development"
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "buildTarget": "expenses-management:build:development",
        "tsConfig": "apps/expenses-management/tsconfig.spec.json",
        "runner": "vitest"
      }
    },
    "stylelint": {
      "command": "stylelint \"apps/expenses-management/**/*.{css,scss}\" --allow-empty-input"
    },
    "lint": {
      "dependsOn": [
        "stylelint"
      ]
    }
  }
}
