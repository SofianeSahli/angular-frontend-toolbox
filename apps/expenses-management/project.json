{
  "name": "expenses-management",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/expenses-management/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath.base}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": {
          "base": "dist/apps/expenses-management"
        },
        "index": "apps/expenses-management/src/index.html",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/expenses-management/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/expenses-management/public"
          }
        ],
        "styles": [
          "bootstrap/dist/css/bootstrap.min.css",
          "apps/expenses-management/src/styles.scss",
          "node_modules/bootstrap-icons/font/bootstrap-icons.css"
        ],
        "stylePreprocessorOptions": {
          "includePaths": ["shared/ui-components/src/lib"]
        },
        "browser": "apps/expenses-management/src/main.ts"
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/launcher/src/environments/environment.ts",
              "with": "apps/launcher/src/environments/environment.prod.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular-devkit/build-angular:dev-server",
      "defaultConfiguration": "development",
      "readyWhen": {
        "signal": true
      },
      "configurations": {
        "production": {
          "buildTarget": "expenses-management:build:production"
        },
        "development": {
          "buildTarget": "expenses-management:build:development"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "expenses-management:build"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "expenses-management:build",
        "spa": true
      }
    }
  }
}
